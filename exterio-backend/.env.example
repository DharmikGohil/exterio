# Copy to .env and fill in. Everything has a working default for local development.

APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# SQLite locally; any Postgres URL in production (postgres:// and postgresql:// both work).
DATABASE_URL=sqlite:///./data/app.db
# Uploaded photos, previews and renders. Mount a persistent volume here in production.
STORAGE_DIR=./data/files

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_DAYS=14
MAX_UPLOAD_MB=15

# Shared reviewer sign-in, shown on the sign-in page and seeded with the sample house.
# It is published, so never reuse a real password here. Empty email switches it off.
DEMO_ACCOUNT_EMAIL=demo@example.com
DEMO_ACCOUNT_PASSWORD=review-2026

# fal.ai key enables automatic region detection (SAM 3) and the photoreal render.
# Without it both features are switched off and regions are drawn by hand.
FAL_KEY=
FAL_SEGMENTATION_MODEL=fal-ai/sam-3/image
FAL_RENDER_MODEL=fal-ai/nano-banana/edit
# Exterio's own photoreal renderer on Modal (see exterio-render/README.md). When both are set it
# is used instead of fal.ai for the photoreal render. The token is the RENDER_TOKEN of the
# exterio-render-auth Modal secret.
MODAL_RENDER_URL=
MODAL_RENDER_TOKEN=
MODAL_RENDER_TIMEOUT_SECONDS=300
# Which photoreal renderer goes first: gemini (default; Gemini's image-editing model, needs
# GOOGLE_VERTEX_CREDENTIALS) or modal (SDXL + ControlNet). The others stay as fallbacks when the
# first is busy or fails. Compare them with scripts/compare_photoreal.py.
PHOTOREAL_RENDERER=gemini
# Per-user cap on photoreal renders in any 24 hours, to protect a public demo.
DAILY_RENDER_LIMIT=10

# Gemini on Google Cloud Vertex AI: a service-account key with the Vertex AI User role, given as
# the path to its JSON file or as the JSON itself (handy on a host). Never commit the key. When
# set, Gemini runs the vision photo check and the material advisor. Region detection stays on
# Claude when ANTHROPIC_API_KEY is set (it measured more accurate), and uses Gemini otherwise,
# or when Claude fails before sending a part.
GOOGLE_VERTEX_CREDENTIALS=
GOOGLE_VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_DETECTION_MODEL=gemini-3.1-pro-preview

# Anthropic key enables the vision photo check and the material advisor. With no FAL_KEY it also
# powers region detection (coarser than SAM 3, but every region is user-reviewed).
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible endpoint. Leave empty to use Anthropic's API.
ANTHROPIC_GATEWAY_URL=
ANTHROPIC_MODEL=claude-opus-5-5
# Auto-detect: longest wait for the next piece of Claude's reply (no retries) before Gemini takes over.
ANTHROPIC_DETECTION_TIMEOUT_SECONDS=60
